# ============================================================
# INALDE · Motor de Curaduría Ejecutiva — variables de entorno
# Copie este archivo como `.env` y ajuste los valores.
#   cp .env.example .env
# ============================================================

# ─── Aplicación ──────────────────────────────────────────────
APP_NAME=INALDE · Motor de Curaduría Ejecutiva
APP_SHORT_NAME=Motor de Curaduría
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# ─── Servidor ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=7070

# ─── Base de datos ───────────────────────────────────────────
# Opción A: definir la URL completa (tiene prioridad sobre las variables POSTGRES_*)
#   En Docker Compose el host es el nombre del servicio: "db".
# DATABASE_URL=postgresql+psycopg://inalde:inalde@db:5432/curaduria_inalde
#
# Opción B: definir las piezas por separado.
POSTGRES_USER=inalde
POSTGRES_PASSWORD=inalde
POSTGRES_DB=curaduria_inalde
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── Almacenamiento de hojas de vida (PDF) ───────────────────
UPLOAD_DIR=./uploads
MAX_PDF_SIZE_MB=10

# ─── Límites del formulario público ──────────────────────────
MAX_FORMACIONES=5
MAX_EXPERIENCIAS=10
MAX_HABILIDADES=20
MAX_IDIOMAS=6

# ─── Módulo administrativo ───────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=inalde1234
# ¡IMPORTANTE! Cambie esto en producción por un valor largo y aleatorio.
SESSION_SECRET=CAMBIAR-EN-PRODUCCION-este-valor-no-es-seguro-solo-dev

# ─── Persistencia ────────────────────────────────────────────
# Debe quedar activo al menos uno entre STORE_HOJAS_VIDA y EMAIL_ENABLED.
STORE_HOJAS_VIDA=true

# ─── Correo (opcional) ───────────────────────────────────────
EMAIL_ENABLED=false
EMAIL_DESTINO=
EMAIL_FROM_NAME=INALDE · Motor de Curaduría Ejecutiva
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
